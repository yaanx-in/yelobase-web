# Add public values with the NEXT_PUBLIC_ prefix; keep secrets out of the repo.

# Canonical site origin (used for canonical URLs, OpenGraph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://yelobase.com

# --- Sanity (blog CMS) ---
# projectId + dataset are public identifiers, not secrets.
NEXT_PUBLIC_SANITY_PROJECT_ID=pkdjcf5g
NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Read (Viewer) token — server-only. Required: this project doesn't serve
# anonymous API reads. Create in sanity.io/manage -> API -> Tokens (Viewer).
SANITY_API_READ_TOKEN=

# Secret shared with the Sanity publish webhook (POST /api/revalidate?secret=...).
# Generate any random string and set the same value in Sanity -> API -> Webhooks.
SANITY_REVALIDATE_SECRET=
